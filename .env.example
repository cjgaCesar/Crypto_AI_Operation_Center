# ==========================================================
# Variables de entorno - Crypto AI Operation Center
# ==========================================================
# Copia este archivo como ".env" (mismo nombre, sin ".example") y completa
# los valores reales cuando los necesites.
#
#   cp .env.example .env        (Git Bash)
#   Copy-Item .env.example .env (PowerShell)
#
# El archivo ".env" NUNCA debe subirse a git (ya está en .gitignore).
#
# IMPORTANTE: en esta etapa (1.5 - preparación de arquitectura) NINGUNA de
# estas variables se usa todavía para conectarse a un servicio real. Son
# solo un espacio reservado para etapas futuras, que el usuario deberá
# autorizar explícitamente antes de activarse.
# ==========================================================

# --- Binance ---
# Solo sería necesario si en el futuro se agregan endpoints privados
# (ej. consultar el balance de una cuenta). La Etapa 1 y 1.5 solo usan
# el endpoint público, que no requiere ninguna clave.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- OpenAI ---
# Para la futura Etapa de Inteligencia Artificial (src/ai/).
OPENAI_API_KEY=

# --- Anthropic / Claude ---
# Para la futura Etapa de Inteligencia Artificial (src/ai/).
ANTHROPIC_API_KEY=

# --- Telegram ---
# Usado por src/paper_trading/notification_channels.py (TelegramNotificationChannel,
# Etapa 6.12) cuando paper_trading.inspection_notifications.telegram=true en
# config.yaml. Deshabilitado por defecto (ese flag es false); si se habilita,
# BOT_TOKEN y CHAT_ID pasan a ser obligatorios. TIMEOUT_SECONDS es opcional
# (por defecto 10 segundos).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10

# --- Slack ---
# Usado por src/paper_trading/notification_channels.py (SlackNotificationChannel,
# Etapa 6.13) cuando paper_trading.inspection_notifications.slack=true en
# config.yaml. Deshabilitado por defecto (ese flag es false); si se habilita,
# WEBHOOK_URL pasa a ser obligatorio (debe ser un Incoming Webhook HTTPS de
# hooks.slack.com u hooks.slack-gov.com). TIMEOUT_SECONDS es opcional (por
# defecto 10 segundos).
SLACK_WEBHOOK_URL=
SLACK_TIMEOUT_SECONDS=10

# --- Email (SMTP) ---
# Usado por src/paper_trading/notification_channels.py (EmailNotificationChannel,
# Etapa 6.14) cuando paper_trading.inspection_notifications.email=true en
# config.yaml. Deshabilitado por defecto (ese flag es false); si se habilita,
# HOST/FROM/TO pasan a ser obligatorios. USERNAME/PASSWORD son opcionales, pero
# deben darse ambos o ninguno. SECURITY debe ser "starttls" o "ssl" (nunca SMTP
# sin cifrar). PORT/TIMEOUT_SECONDS tienen valores por defecto seguros.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_SECURITY=starttls
EMAIL_TIMEOUT_SECONDS=10

# --- Webhook HTTP genérico ---
# Usado por src/paper_trading/notification_channels.py (WebhookNotificationChannel,
# Etapa 6.15) cuando paper_trading.inspection_notifications.webhook=true en
# config.yaml. Deshabilitado por defecto (ese flag es false); si se habilita,
# ENDPOINT_URL pasa a ser obligatorio (debe ser HTTPS, puerto por defecto,
# sin userinfo/query/fragment, con protección mínima contra SSRF -- ver
# src/paper_trading/webhook_transport.py). AUTHORIZATION_SECRET es opcional
# (nunca debe incluir el prefijo "Bearer "; el transporte lo agrega).
# TIMEOUT_SECONDS es opcional (por defecto 10 segundos).
WEBHOOK_ENDPOINT_URL=
WEBHOOK_AUTHORIZATION_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10

# --- CoinGecko ---
# Fuente de datos de mercado adicional, para una futura etapa de múltiples
# exchanges/fuentes de datos.
COINGECKO_API_KEY=

# --- NewsAPI ---
# Noticias para el futuro análisis con IA (src/ai/).
NEWSAPI_API_KEY=

# --- Base de datos ---
# Solo se usará si database.engine en config.yaml se cambia a "postgres"
# en una etapa futura (ver src/database/postgres_repository.py).
DATABASE_URL=
