# ==========================================================
# Variables de entorno - Crypto AI Operation Center
# ==========================================================
# Copia este archivo como ".env" (mismo nombre, sin ".example") y completa
# los valores reales cuando los necesites.
#
#   cp .env.example .env        (Git Bash)
#   Copy-Item .env.example .env (PowerShell)
#
# El archivo ".env" NUNCA debe subirse a git (ya está en .gitignore).
#
# IMPORTANTE: en esta etapa (1.5 - preparación de arquitectura) NINGUNA de
# estas variables se usa todavía para conectarse a un servicio real. Son
# solo un espacio reservado para etapas futuras, que el usuario deberá
# autorizar explícitamente antes de activarse.
# ==========================================================

# --- Binance ---
# Solo sería necesario si en el futuro se agregan endpoints privados
# (ej. consultar el balance de una cuenta). La Etapa 1 y 1.5 solo usan
# el endpoint público, que no requiere ninguna clave.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- OpenAI ---
# Para la futura Etapa de Inteligencia Artificial (src/ai/).
OPENAI_API_KEY=

# --- Anthropic / Claude ---
# Para la futura Etapa de Inteligencia Artificial (src/ai/).
ANTHROPIC_API_KEY=

# --- Telegram ---
# Usado por src/paper_trading/notification_channels.py (TelegramNotificationChannel,
# Etapa 6.12) cuando paper_trading.inspection_notifications.telegram=true en
# config.yaml. Deshabilitado por defecto (ese flag es false); si se habilita,
# BOT_TOKEN y CHAT_ID pasan a ser obligatorios. TIMEOUT_SECONDS es opcional
# (por defecto 10 segundos).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10

# --- CoinGecko ---
# Fuente de datos de mercado adicional, para una futura etapa de múltiples
# exchanges/fuentes de datos.
COINGECKO_API_KEY=

# --- NewsAPI ---
# Noticias para el futuro análisis con IA (src/ai/).
NEWSAPI_API_KEY=

# --- Base de datos ---
# Solo se usará si database.engine en config.yaml se cambia a "postgres"
# en una etapa futura (ver src/database/postgres_repository.py).
DATABASE_URL=
